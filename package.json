{
  "name": "agentmesh",
  "productName": "AgentMesh",
  "version": "1.0.0",
  "description": "A control plane for running many Claude Code agents at once — terminals, plus a live view of every session on the machine.",
  "main": "src/main/main.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dev": "ELECTRON_ENABLE_LOGGING=1 electron .",
    "lint": "eslint .",
    "postinstall": "electron-builder install-app-deps",
    "fonts": "node tools/build-fonts.js",
    "icon": "node tools/make-icon.js",
    "dist": "electron-builder",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "keywords": [
    "claude-code",
    "terminal",
    "electron",
    "agents"
  ],
  "author": "Karan Anand",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thekarananand/agentmesh.git"
  },
  "bugs": {
    "url": "https://github.com/thekarananand/agentmesh/issues"
  },
  "homepage": "https://github.com/thekarananand/agentmesh#readme",
  "type": "commonjs",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "electron": "^43.3.0",
    "electron-builder": "^25.1.8",
    "eslint": "^9.19.0",
    "globals": "^15.14.0",
    "wawoff2": "^2.0.1"
  },
  "dependencies": {
    "node-pty": "^1.1.0",
    "xterm": "^5.3.0",
    "xterm-addon-canvas": "^0.5.0"
  },
  "build": {
    "appId": "dev.agentmesh.app",
    "productName": "AgentMesh",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "src/main/main.js",
      "src/preload/preload.js",
      "src/renderer/renderer.js",
      "src/renderer/index.html",
      "src/lib/sessions.js",
      "src/lib/rename.js",
      "src/lib/autoname.js",
      "src/lib/usage.js",
      "src/lib/config.js",
      "src/lib/claude.js",
      "src/lib/platform.js",
      "src/lib/titlebar.js",
      "src/lib/debug.js",
      "assets/**/*",
      "node_modules/xterm/lib/xterm.js",
      "node_modules/xterm/css/xterm.css",
      "node_modules/xterm-addon-canvas/lib/xterm-addon-canvas.js",
      "node_modules/node-pty/**/*"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "category": "Development",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
